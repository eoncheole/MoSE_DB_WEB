# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# --- Database (Postgres) ---
# Used by both the db container and the backend's DATABASE_URL.
POSTGRES_USER=mose
POSTGRES_PASSWORD=
POSTGRES_DB=mose_db

# --- Auth (backend) ---
# JWT signing key. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Access token lifetime in minutes (optional, defaults to 30).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (backend) ---
# Comma-separated list of allowed frontend origins. No wildcard "*".
CORS_ORIGINS=http://localhost:3000

# --- Admin seeding (backend) ---
# Set SEED_ADMIN=false once a real admin account exists.
SEED_ADMIN=true
ADMIN_EMAIL=admin
# Use a strong password; the app warns if left as the default "admin".
ADMIN_PASSWORD=
